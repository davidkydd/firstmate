{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstmate.local/schemas/teams/request.v1.json",
  "title": "Firstmate Teams request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "receivedAt", "resultDeadline", "source", "command", "bodySha256"],
  "properties": {
    "schema": { "const": "firstmate.teams.request.v1" },
    "requestId": { "type": "string", "pattern": "^tm_[a-f0-9]{64}$" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "resultDeadline": { "type": "string", "format": "date-time" },
    "bodySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "$ref": "#/$defs/source" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["status", "work"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "senderId", "senderAadObjectId", "conversationId", "conversationType", "activityId", "activityTimestamp", "serviceUrl", "botId", "channelId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "senderAadObjectId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "conversationType": { "enum": ["personal", "groupChat", "channel"] },
        "activityId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "activityTimestamp": { "type": "string", "format": "date-time" },
        "serviceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "botId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "channelId": { "const": "msteams" }
      }
    }
  }
}
