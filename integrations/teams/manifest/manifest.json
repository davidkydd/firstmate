{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.1.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Firstmate service owner",
    "websiteUrl": "https://firstmate.invalid",
    "privacyUrl": "https://firstmate.invalid/privacy",
    "termsOfUseUrl": "https://firstmate.invalid/terms"
  },
  "name": {
    "short": "Firstmate",
    "full": "Firstmate private mobile request bridge"
  },
  "description": {
    "short": "Send bounded requests to a trusted Firstmate session.",
    "full": "A single-tenant bot that stores validated Teams requests in Azure and relays them to one outbound-only Firstmate connector. Privileged actions still require confirmation in the trusted local session."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#0B3558",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal", "groupChat", "team"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "/firstmate",
              "description": "Send a status query or ordinary reversible request."
            }
          ]
        },
        {
          "scopes": ["groupChat", "team"],
          "commands": [
            {
              "title": "/firstmate",
              "description": "Mention Firstmate, then send a status query or ordinary reversible request."
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity"],
  "validDomains": []
}
